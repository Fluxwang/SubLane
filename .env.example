# The Go service reads process environment, not .env files automatically.
SUBLANE_ADDR=127.0.0.1:8080
SUBLANE_DATA_DIR=./data
SUBLANE_LOG_LEVEL=info
# Read-only demo with public demo / sublane-demo login. Uses disposable temporary data;
# ignores SUBLANE_DATA_DIR and all pricing paths. No live provider requests.
SUBLANE_DEMO=false
# Model request and reconstructed WebSocket context limit in MiB; responses/events remain 8 MiB.
SUBLANE_MAX_REQUEST_BODY_MB=128
# Per-workspace runtime policy. Restart/recreate the service after changing these.
# SUBLANE_GATEWAY_CAPACITY=128
# SUBLANE_GATEWAY_QUEUE_LIMIT=100
# SUBLANE_GATEWAY_QUEUE_TIMEOUT=30s
# SUBLANE_GATEWAY_REQUEST_TIMEOUT=30m
# Optional upstream stream idle timeout; 0s disables it. SSE heartbeats do not reset it.
# SUBLANE_GATEWAY_STREAM_IDLE_TIMEOUT=0s
# SUBLANE_GATEWAY_KEEPALIVE_INTERVAL=10s
# Retry only explicit temporary HTTP rejections before a successful response; 0 disables retries.
# SUBLANE_GATEWAY_RETRIES=2
# SUBLANE_GATEWAY_RETRY_DELAY=500ms
# Transient failures affect only the selected model; threshold 0 disables this cooldown.
# SUBLANE_GATEWAY_TRANSIENT_THRESHOLD=3
# SUBLANE_GATEWAY_TRANSIENT_WINDOW=2m
# SUBLANE_GATEWAY_TRANSIENT_COOLDOWN=10s
# Fallback only; a real upstream Retry-After takes precedence.
# SUBLANE_GATEWAY_RATE_LIMIT_COOLDOWN=5s
# Inference response-header wait; 0s disables it. Metadata retains its shorter timeout.
# SUBLANE_INFERENCE_HEADER_TIMEOUT=5m
# Set the external origin when serving behind a reverse proxy.
# HTTPS origins enable Secure session cookies.
# SUBLANE_PUBLIC_URL=https://sublane.example.com
# Trust only the CIDR addresses of your own reverse proxy; keep unset for direct access.
# SUBLANE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Model price catalog (LiteLLM-compatible JSON; defaults to Sub2API's model-price-repo).
# Prices are cached locally and copied into new allocation revisions.
# SUBLANE_PRICING_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.json
# Set a matching hash URL with a custom price URL to retain SHA-256 verification.
# SUBLANE_PRICING_HASH_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.sha256
# SUBLANE_PRICING_CACHE=./data/model-prices.json
# SUBLANE_PRICING_FALLBACK=./data/model-prices.fallback.json
# SUBLANE_PRICING_OVERRIDE=./data/model-prices.override.json
# SUBLANE_PRICING_INTERVAL=6h

# Docker Compose interpolation only; these do not configure the Go process directly.
# Pin a version that has actually been published, or use a full image digest.
# SUBLANE_IMAGE=ghcr.io/murongg/sublane:0.1.0
# SUBLANE_BIND_ADDRESS=127.0.0.1
# SUBLANE_PORT=8080
